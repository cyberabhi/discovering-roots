# Required to read published content from Sanity. These values are server-side.
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
SANITY_API_VERSION=2025-02-19

# Optional: required only for authenticated draft preview. Never use a VITE_ prefix.
SANITY_API_READ_TOKEN=replace-with-a-server-only-viewer-token
SANITY_PREVIEW_SECRET=replace-with-a-long-random-server-only-secret

# Public URL of a separately deployed, access-controlled Sanity Studio.
VITE_SANITY_STUDIO_URL=https://your-studio.sanity.studio
